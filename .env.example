# Gemini API Key Configuration
# You can provide multiple keys. When one key hits the free-tier rate limit (HTTP 429),
# the generator will automatically rotate to the next key without failing!

# Option 1: Comma-separated list of keys (recommended for multiple keys)
# GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3..."

# Option 2: Numbered keys
# GEMINI_API_KEY_1="AIzaSyKey1..."
# GEMINI_API_KEY_2="AIzaSyKey2..."
# GEMINI_API_KEY_3="AIzaSyKey3..."

# Option 3: Single primary key
GEMINI_API_KEY=""

