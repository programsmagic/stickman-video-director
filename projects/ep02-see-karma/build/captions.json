[
 {
  "start": 0.15,
  "end": 1.01,
  "text": "You wake up,"
 },
 {
  "start": 1.23,
  "end": 1.79,
  "text": "look in the mirror,"
 },
 {
  "start": 2.05,
  "end": 4.55,
  "text": "and there's a number above your head again."
 },
 {
  "start": 5.03,
  "end": 5.85,
  "text": "But this time,"
 },
 {
  "start": 6.13,
  "end": 6.79,
  "text": "it isn't money."
 },
 {
  "start": 7.71,
  "end": 9.35,
  "text": "Plus seventy-three."
 },
 {
  "start": 9.35,
  "end": 10.11,
  "text": "It's your karma."
 },
 {
  "start": 10.99,
  "end": 12.73,
  "text": "Every kind thing you've ever done,"
 },
 {
  "start": 12.81,
  "end": 14.31,
  "text": "minus every cruel one,"
 },
 {
  "start": 14.61,
  "end": 15.75,
  "text": "added into a single score."
 },
 {
  "start": 16.81,
  "end": 17.67,
  "text": "Everyone has one."
 },
 {
  "start": 18.53,
  "end": 19.61,
  "text": "For the next seven days,"
 },
 {
  "start": 19.81,
  "end": 21.81,
  "text": "you can see exactly how good,"
 },
 {
  "start": 21.81,
  "end": 22.75,
  "text": "or how bad,"
 },
 {
  "start": 22.75,
  "end": 24.25,
  "text": "everyone really is."
 },
 {
  "start": 24.69,
  "end": 25.89,
  "text": "And by day seven,"
 },
 {
  "start": 25.97,
  "end": 28.05,
  "text": "the lowest number in the city will"
 },
 {
  "start": 28.05,
  "end": 30.07,
  "text": "belong to someone you'd never expect."
 },
 {
  "start": 30.99,
  "end": 32.63,
  "text": "At first, it's just fascinating."
 },
 {
  "start": 33.29,
  "end": 34.95,
  "text": "The barista who remembers everyone's"
 },
 {
  "start": 34.95,
  "end": 37.27,
  "text": "name is at plus four hundred and ten."
 },
 {
  "start": 37.27,
  "end": 40.23,
  "text": "The man yelling at his phone is at minus thirty-eight."
 },
 {
  "start": 40.23,
  "end": 40.61,
  "text": "Fair enough."
 },
 {
  "start": 41.37,
  "end": 43.87,
  "text": "But then you see the man in the expensive suit."
 },
 {
  "start": 44.41,
  "end": 45.55,
  "text": "The one who looks like he'd step"
 },
 {
  "start": 45.55,
  "end": 46.87,
  "text": "over you to catch a taxi."
 },
 {
  "start": 47.67,
  "end": 49.32,
  "text": "Plus two thousand,"
 },
 {
  "start": 49.32,
  "end": 50.53,
  "text": "three hundred."
 },
 {
  "start": 50.53,
  "end": 51.61,
  "text": "You don't know what he did."
 },
 {
  "start": 51.95,
  "end": 52.67,
  "text": "You'll never know."
 },
 {
  "start": 53.15,
  "end": 54.29,
  "text": "But he did a lot of it."
 },
 {
  "start": 54.29,
  "end": 57.35,
  "text": "And the little girl holding her mum's hand?"
 },
 {
  "start": 58.01,
  "end": 59.35,
  "text": "Plus ninety."
 },
 {
  "start": 59.35,
  "end": 60.45,
  "text": "Already beating you."
 },
 {
  "start": 61.27,
  "end": 62.41,
  "text": "Lesson one, before breakfast:"
 },
 {
  "start": 63.03,
  "end": 63.61,
  "text": "just like money,"
 },
 {
  "start": 63.61,
  "end": 65.95,
  "text": "you can't see goodness from the outside."
 },
 {
  "start": 67.13,
  "end": 68.03,
  "text": "Then you walk into work."
 },
 {
  "start": 68.83,
  "end": 69.43,
  "text": "And there's Kevin."
 },
 {
  "start": 69.43,
  "end": 72.67,
  "text": "Kevin, who forwards your emails and calls it teamwork."
 },
 {
  "start": 73.39,
  "end": 76.47,
  "text": "Kevin is at plus eight hundred and eighty."
 },
 {
  "start": 76.47,
  "end": 78.23,
  "text": "That's more than ten times your number."
 },
 {
  "start": 78.23,
  "end": 80.03,
  "text": "You can't stop staring,"
 },
 {
  "start": 80.19,
  "end": 80.93,
  "text": "so at lunch,"
 },
 {
  "start": 80.93,
  "end": 81.61,
  "text": "you ask around."
 },
 {
  "start": 82.33,
  "end": 84.05,
  "text": "Kevin covers night shifts for a"
 },
 {
  "start": 84.05,
  "end": 85.43,
  "text": "coworker whose kid is sick."
 },
 {
  "start": 86.15,
  "end": 86.71,
  "text": "Every week."
 },
 {
  "start": 87.23,
  "end": 88.41,
  "text": "He never mentioned it."
 },
 {
  "start": 88.99,
  "end": 90.35,
  "text": "You ask him why he never told anyone."
 },
 {
  "start": 91.21,
  "end": 91.63,
  "text": "He shrugs."
 },
 {
  "start": 92.63,
  "end": 94.56,
  "text": "\"Didn't seem like the kind of thing you announce.\""
 },
 {
  "start": 94.56,
  "end": 97.39,
  "text": "You've spent years deciding who Kevin was"
 },
 {
  "start": 97.39,
  "end": 99.11,
  "text": "from the tiny part of him you could see."
 },
 {
  "start": 99.75,
  "end": 101.45,
  "text": "You were wrong about his salary last week."
 },
 {
  "start": 102.15,
  "end": 103.15,
  "text": "You were wrong about this,"
 },
 {
  "start": 103.15,
  "end": 103.41,
  "text": "too."
 },
 {
  "start": 104.27,
  "end": 105.23,
  "text": "On day three,"
 },
 {
  "start": 105.23,
  "end": 107.55,
  "text": "a man at the mall hands you a free sample."
 },
 {
  "start": 108.23,
  "end": 110.57,
  "text": "He's smiling, but his number doesn't move."
 },
 {
  "start": 110.69,
  "end": 111.85,
  "text": "Not even by one."
 },
 {
  "start": 112.35,
  "end": 113.83,
  "text": "Because karma, you realize,"
 },
 {
  "start": 113.99,
  "end": 116.67,
  "text": "can tell the difference between a gift and a hook."
 },
 {
  "start": 117.41,
  "end": 118.21,
  "text": "And the hook works."
 },
 {
  "start": 118.75,
  "end": 119.65,
  "text": "In a famous experiment,"
 },
 {
  "start": 119.85,
  "end": 122.45,
  "text": "a researcher bought people a can of Coke as a small,"
 },
 {
  "start": 122.45,
  "end": 123.41,
  "text": "unexpected favor."
 },
 {
  "start": 123.91,
  "end": 125.55,
  "text": "Later, he asked them to buy raffle tickets."
 },
 {
  "start": 126.11,
  "end": 127.29,
  "text": "The people who got the Coke bought"
 },
 {
  "start": 127.29,
  "end": 129.15,
  "text": "about twice as many tickets."
 },
 {
  "start": 129.49,
  "end": 131.19,
  "text": "Even the ones who didn't like him."
 },
 {
  "start": 131.19,
  "end": 132.95,
  "text": "A small favor makes us feel"
 },
 {
  "start": 132.95,
  "end": 134.37,
  "text": "like we owe something back."
 },
 {
  "start": 134.91,
  "end": 136.07,
  "text": "It's called reciprocity."
 },
 {
  "start": 136.49,
  "end": 138.51,
  "text": "It's one of the strongest forces in human behaviour,"
 },
 {
  "start": 138.51,
  "end": 140.43,
  "text": "and salespeople know it."
 },
 {
  "start": 140.71,
  "end": 143.05,
  "text": "Ever wondered why supermarkets hand out free samples?"
 },
 {
  "start": 143.79,
  "end": 144.53,
  "text": "Now you know."
 },
 {
  "start": 145.15,
  "end": 146.19,
  "text": "You buy the thing anyway."
 },
 {
  "start": 146.69,
  "end": 147.95,
  "text": "Your number drops by one,"
 },
 {
  "start": 148.47,
  "end": 149.89,
  "text": "for buying something you didn't need"
 },
 {
  "start": 149.89,
  "end": 151.71,
  "text": "with money you'd promised to save."
 },
 {
  "start": 152.69,
  "end": 153.75,
  "text": "So on day four,"
 },
 {
  "start": 153.95,
  "end": 154.91,
  "text": "you come up with a plan."
 },
 {
  "start": 155.31,
  "end": 156.91,
  "text": "You're going to farm karma."
 },
 {
  "start": 157.53,
  "end": 159.23,
  "text": "You help an old man carry his groceries."
 },
 {
  "start": 159.23,
  "end": 160.39,
  "text": "You hold doors."
 },
 {
  "start": 160.39,
  "end": 162.43,
  "text": "You tell everyone their haircut looks great."
 },
 {
  "start": 162.43,
  "end": 163.84,
  "text": "Your number goes up."
 },
 {
  "start": 164.49,
  "end": 165.59,
  "text": "Plus seventy-four."
 },
 {
  "start": 165.59,
  "end": 166.97,
  "text": "Plus seventy-five."
 },
 {
  "start": 166.97,
  "end": 167.43,
  "text": "Slowly."
 },
 {
  "start": 168.15,
  "end": 168.99,
  "text": "Painfully slowly."
 },
 {
  "start": 169.67,
  "end": 171.27,
  "text": "By evening, you've helped eleven people,"
 },
 {
  "start": 171.55,
  "end": 172.19,
  "text": "your feet hurt,"
 },
 {
  "start": 172.29,
  "end": 173.55,
  "text": "and you've gained four points."
 },
 {
  "start": 174.11,
  "end": 175.83,
  "text": "It's almost like the number knows"
 },
 {
  "start": 175.83,
  "end": 177.45,
  "text": "when kindness is a performance."
 },
 {
  "start": 178.45,
  "end": 179.53,
  "text": "Then, on the way home,"
 },
 {
  "start": 179.65,
  "end": 180.73,
  "text": "you buy two hot chocolates,"
 },
 {
  "start": 181.17,
  "end": 182.61,
  "text": "and for no reason at all,"
 },
 {
  "start": 182.83,
  "end": 185.25,
  "text": "you hand one to a stranger shivering at the bus stop."
 },
 {
  "start": 185.77,
  "end": 188.01,
  "text": "She looks at you like you just handed her the moon."
 },
 {
  "start": 188.65,
  "end": 189.31,
  "text": "Plus six."
 },
 {
  "start": 189.97,
  "end": 190.73,
  "text": "In one second."
 },
 {
  "start": 190.73,
  "end": 192.99,
  "text": "Psychologists actually tested this."
 },
 {
  "start": 193.35,
  "end": 194.41,
  "text": "They had people give hot chocolate"
 },
 {
  "start": 194.41,
  "end": 195.49,
  "text": "to strangers in a park,"
 },
 {
  "start": 195.65,
  "end": 197.67,
  "text": "then asked them to guess how the strangers would feel."
 },
 {
  "start": 198.45,
  "end": 199.47,
  "text": "The givers guessed wrong."
 },
 {
  "start": 199.79,
  "end": 200.53,
  "text": "Every time."
 },
 {
  "start": 201.05,
  "end": 202.15,
  "text": "The strangers felt much better"
 },
 {
  "start": 202.15,
  "end": 203.07,
  "text": "than the givers predicted."
 },
 {
  "start": 203.73,
  "end": 205.79,
  "text": "We constantly underestimate how much a"
 },
 {
  "start": 205.79,
  "end": 208.05,
  "text": "small kindness means to someone else."
 },
 {
  "start": 208.95,
  "end": 209.97,
  "text": "On day five,"
 },
 {
  "start": 210.19,
  "end": 210.83,
  "text": "you see her again."
 },
 {
  "start": 211.11,
  "end": 212.23,
  "text": "The woman from the bus stop."
 },
 {
  "start": 212.91,
  "end": 214.25,
  "text": "She's at the hospital entrance,"
 },
 {
  "start": 214.25,
  "end": 216.15,
  "text": "holding the door for a man on crutches."
 },
 {
  "start": 216.89,
  "end": 217.79,
  "text": "The man on crutches,"
 },
 {
  "start": 217.79,
  "end": 218.85,
  "text": "ten minutes later,"
 },
 {
  "start": 219.05,
  "end": 220.13,
  "text": "lets a mother with a crying"
 },
 {
  "start": 220.13,
  "end": 221.47,
  "text": "baby go ahead of him in line."
 },
 {
  "start": 222.01,
  "end": 222.57,
  "text": "And the mother,"
 },
 {
  "start": 222.73,
  "end": 223.53,
  "text": "on her way out,"
 },
 {
  "start": 223.77,
  "end": 225.83,
  "text": "pays for the coffee of the person behind her."
 },
 {
  "start": 226.25,
  "end": 227.17,
  "text": "One hot chocolate."
 },
 {
  "start": 228.03,
  "end": 229.65,
  "text": "Three more good things you"
 },
 {
  "start": 229.65,
  "end": 230.83,
  "text": "never would have known about."
 },
 {
  "start": 230.91,
  "end": 233.05,
  "text": "And none of them will ever know it started with you."
 },
 {
  "start": 233.93,
  "end": 235.33,
  "text": "Scientists have found something"
 },
 {
  "start": 235.33,
  "end": 236.39,
  "text": "like this in experiments."
 },
 {
  "start": 236.39,
  "end": 238.31,
  "text": "When people played games where"
 },
 {
  "start": 238.31,
  "end": 239.55,
  "text": "they could share with a group,"
 },
 {
  "start": 239.93,
  "end": 241.95,
  "text": "generosity spread from person to person,"
 },
 {
  "start": 241.95,
  "end": 243.21,
  "text": "up to three steps away."
 },
 {
  "start": 243.69,
  "end": 246.21,
  "text": "Each extra bit of sharing ended up multiplied,"
 },
 {
  "start": 246.21,
  "end": 247.71,
  "text": "as others copied it."
 },
 {
  "start": 248.25,
  "end": 249.85,
  "text": "But here's the uncomfortable part."
 },
 {
  "start": 250.49,
  "end": 252.35,
  "text": "Selfishness spread just as easily."
 },
 {
  "start": 253.01,
  "end": 255.07,
  "text": "Every day, you're starting a chain reaction."
 },
 {
  "start": 255.37,
  "end": 256.85,
  "text": "You just never get to see where it ends."
 },
 {
  "start": 257.45,
  "end": 259.13,
  "text": "The only choice is which kind."
 },
 {
  "start": 260.05,
  "end": 261.25,
  "text": "Then, on day six,"
 },
 {
  "start": 261.31,
  "end": 262.09,
  "text": "something changes."
 },
 {
  "start": 262.87,
  "end": 264.53,
  "text": "Everyone can see everyone's karma."
 },
 {
  "start": 264.53,
  "end": 266.57,
  "text": "And the world goes a little crazy."
 },
 {
  "start": 267.33,
  "end": 269.21,
  "text": "People start doing good deeds for the camera."
 },
 {
  "start": 269.93,
  "end": 271.53,
  "text": "Restaurants only let in high numbers."
 },
 {
  "start": 272.15,
  "end": 273.51,
  "text": "Dating apps sort by karma."
 },
 {
  "start": 273.51,
  "end": 275.65,
  "text": "Within hours, someone builds an app"
 },
 {
  "start": 275.65,
  "end": 277.25,
  "text": "that ranks everyone in the city,"
 },
 {
  "start": 277.71,
  "end": 278.01,
  "text": "live."
 },
 {
  "start": 278.59,
  "end": 280.11,
  "text": "That evening, Leo calls you."
 },
 {
  "start": 280.43,
  "end": 282.53,
  "text": "His number dropped after he snapped at a waiter,"
 },
 {
  "start": 282.53,
  "end": 284.29,
  "text": "and now strangers are staring at him."
 },
 {
  "start": 284.51,
  "end": 285.35,
  "text": "He sounds scared."
 },
 {
  "start": 286.23,
  "end": 288.51,
  "text": "\"What if people only ever see the worst thing I did?\""
 },
 {
  "start": 289.43,
  "end": 290.51,
  "text": "And people with low numbers"
 },
 {
  "start": 290.51,
  "end": 291.49,
  "text": "get treated like criminals."
 },
 {
  "start": 292.31,
  "end": 293.55,
  "text": "Then something strange happens."
 },
 {
  "start": 294.11,
  "end": 295.95,
  "text": "A man in your building loses his job."
 },
 {
  "start": 296.35,
  "end": 297.13,
  "text": "And the neighbours whisper,"
 },
 {
  "start": 297.57,
  "end": 298.77,
  "text": "\"He must have deserved it.\""
 },
 {
  "start": 299.01,
  "end": 300.29,
  "text": "But you can see his number."
 },
 {
  "start": 300.71,
  "end": 301.777,
  "text": "Plus one thousand,"
 },
 {
  "start": 301.777,
  "end": 303.39,
  "text": "nine hundred and fifty."
 },
 {
  "start": 303.39,
  "end": 305.67,
  "text": "Psychologists call this the just-world belief."
 },
 {
  "start": 306.11,
  "end": 307.85,
  "text": "We want to believe the world is fair,"
 },
 {
  "start": 308.15,
  "end": 309.55,
  "text": "that good things happen to good people"
 },
 {
  "start": 309.77,
  "end": 311.17,
  "text": "and bad things happen to bad ones."
 },
 {
  "start": 311.77,
  "end": 313.49,
  "text": "So when something bad happens to someone,"
 },
 {
  "start": 313.87,
  "end": 315.85,
  "text": "we quietly assume they earned it."
 },
 {
  "start": 315.85,
  "end": 317.45,
  "text": "It makes us feel safe."
 },
 {
  "start": 318.03,
  "end": 319.19,
  "text": "And it makes us cruel."
 },
 {
  "start": 319.79,
  "end": 321.17,
  "text": "Sometimes, bad things happen to"
 },
 {
  "start": 321.17,
  "end": 322.11,
  "text": "people with great numbers."
 },
 {
  "start": 323.15,
  "end": 325.11,
  "text": "Remember the lowest number in the city?"
 },
 {
  "start": 325.71,
  "end": 327.33,
  "text": "The one you were never supposed to expect?"
 },
 {
  "start": 327.33,
  "end": 328.81,
  "text": "On day seven,"
 },
 {
  "start": 329.13,
  "end": 330.13,
  "text": "you finally find it."
 },
 {
  "start": 331.01,
  "end": 332.67,
  "text": "It's above a woman in a grey uniform,"
 },
 {
  "start": 333.11,
  "end": 334.49,
  "text": "standing next to a parking meter."
 },
 {
  "start": 335.25,
  "end": 336.743,
  "text": "Minus four thousand,"
 },
 {
  "start": 336.743,
  "end": 338.85,
  "text": "one hundred and twenty."
 },
 {
  "start": 338.85,
  "end": 340.07,
  "text": "She's a parking officer."
 },
 {
  "start": 340.85,
  "end": 342.11,
  "text": "Every day, people curse at her,"
 },
 {
  "start": 342.41,
  "end": 343.23,
  "text": "slam their car doors,"
 },
 {
  "start": 343.33,
  "end": 344.21,
  "text": "and wish her the worst."
 },
 {
  "start": 345.01,
  "end": 345.91,
  "text": "But here's the thing."
 },
 {
  "start": 346.55,
  "end": 348.39,
  "text": "Her number isn't low because of what she's done."
 },
 {
  "start": 349.07,
  "end": 350.11,
  "text": "It's low because of what"
 },
 {
  "start": 350.11,
  "end": 351.83,
  "text": "everyone else has said to her."
 },
 {
  "start": 352.47,
  "end": 353.59,
  "text": "And when you look closer,"
 },
 {
  "start": 353.59,
  "end": 355.09,
  "text": "the number flickers."
 },
 {
  "start": 355.63,
  "end": 357.31,
  "text": "Underneath, faint and small,"
 },
 {
  "start": 357.87,
  "end": 358.89,
  "text": "there's a second one."
 },
 {
  "start": 359.43,
  "end": 360.8,
  "text": "Plus three thousand,"
 },
 {
  "start": 360.8,
  "end": 361.83,
  "text": "six hundred."
 },
 {
  "start": 361.83,
  "end": 362.65,
  "text": "Her real karma."
 },
 {
  "start": 363.59,
  "end": 365.39,
  "text": "The big red number was never hers."
 },
 {
  "start": 365.39,
  "end": 366.85,
  "text": "It was ours."
 },
 {
  "start": 367.97,
  "end": 368.65,
  "text": "You walk over,"
 },
 {
  "start": 369.23,
  "end": 371.45,
  "text": "and you tell her she's doing a hard job well."
 },
 {
  "start": 372.17,
  "end": 372.71,
  "text": "She laughs."
 },
 {
  "start": 373.35,
  "end": 376.09,
  "text": "She says nobody has said that to her in eleven years."
 },
 {
  "start": 376.85,
  "end": 378.19,
  "text": "Then she tells you about a man who"
 },
 {
  "start": 378.19,
  "end": 379.35,
  "text": "once thanked her for a ticket,"
 },
 {
  "start": 379.35,
  "end": 381.33,
  "text": "because it reminded him to fix his brakes"
 },
 {
  "start": 381.33,
  "end": 382.97,
  "text": "before a long drive with his kids."
 },
 {
  "start": 383.57,
  "end": 384.85,
  "text": "She still remembers his face."
 },
 {
  "start": 385.91,
  "end": 387.79,
  "text": "At midnight, the numbers fade."
 },
 {
  "start": 388.41,
  "end": 390.73,
  "text": "The last one you see is your own."
 },
 {
  "start": 391.03,
  "end": 392.65,
  "text": "Plus eighty-one."
 },
 {
  "start": 392.65,
  "end": 393.39,
  "text": "Not huge."
 },
 {
  "start": 393.77,
  "end": 394.43,
  "text": "Not perfect."
 },
 {
  "start": 394.97,
  "end": 396.57,
  "text": "But higher than a week ago."
 },
 {
  "start": 397.39,
  "end": 398.85,
  "text": "And you realize what moved it"
 },
 {
  "start": 398.85,
  "end": 400.29,
  "text": "most wasn't the grand gestures."
 },
 {
  "start": 400.89,
  "end": 402.55,
  "text": "It was a hot chocolate."
 },
 {
  "start": 403.39,
  "end": 405.45,
  "text": "A text to Leo asking if he was okay."
 },
 {
  "start": 406.31,
  "end": 409.71,
  "text": "One kind sentence to a woman everyone else yells at."
 },
 {
  "start": 410.33,
  "end": 411.31,
  "text": "So before bed,"
 },
 {
  "start": 411.43,
  "end": 412.85,
  "text": "you send one more message."
 },
 {
  "start": 413.35,
  "end": 414.59,
  "text": "A thank-you to your mum,"
 },
 {
  "start": 414.59,
  "end": 416.75,
  "text": "for something she did fifteen years"
 },
 {
  "start": 416.75,
  "end": 418.29,
  "text": "ago that you never mentioned."
 },
 {
  "start": 419.09,
  "end": 420.55,
  "text": "Then Kevin texts you a photo."
 },
 {
  "start": 421.05,
  "end": 422.27,
  "text": "He's covering another night shift,"
 },
 {
  "start": 422.27,
  "end": 425.17,
  "text": "and the office coffee machine is broken again."
 },
 {
  "start": 425.91,
  "end": 427.51,
  "text": "You laugh, grab your coat,"
 },
 {
  "start": 427.51,
  "end": 428.69,
  "text": "and bring him a coffee."
 },
 {
  "start": 429.97,
  "end": 431.89,
  "text": "Some numbers you'll never see go up."
 },
 {
  "start": 432.31,
  "end": 434.33,
  "text": "Some kindness nobody will ever count."
 },
 {
  "start": 434.97,
  "end": 435.69,
  "text": "That's fine."
 },
 {
  "start": 436.25,
  "end": 436.95,
  "text": "It still counts."
 },
 {
  "start": 438.07,
  "end": 440.41,
  "text": "There's a famous study that found people"
 },
 {
  "start": 440.41,
  "end": 442.53,
  "text": "who spent money on others felt happier"
 },
 {
  "start": 442.53,
  "end": 444.25,
  "text": "than people who spent it on themselves."
 },
 {
  "start": 444.85,
  "end": 446.57,
  "text": "A later attempt to repeat it"
 },
 {
  "start": 446.57,
  "end": 447.83,
  "text": "didn't find the same effect,"
 },
 {
  "start": 448.25,
  "end": 450.17,
  "text": "so scientists are still arguing about it."
 },
 {
  "start": 450.47,
  "end": 452.65,
  "text": "But you don't need a study for this one."
 },
 {
  "start": 453.23,
  "end": 454.83,
  "text": "Here's what seven days of seeing"
 },
 {
  "start": 454.83,
  "end": 456.39,
  "text": "everyone's karma taught you."
 },
 {
  "start": 457.11,
  "end": 458.91,
  "text": "You can't see goodness from the outside."
 },
 {
  "start": 459.73,
  "end": 461.87,
  "text": "Small kindness travels further than you think."
 },
 {
  "start": 462.63,
  "end": 464.67,
  "text": "Bad luck doesn't mean a bad person."
 },
 {
  "start": 465.25,
  "end": 467.77,
  "text": "And sometimes, the lowest number is"
 },
 {
  "start": 467.77,
  "end": 469.37,
  "text": "just the one everyone else wrote."
 },
 {
  "start": 470.23,
  "end": 471.89,
  "text": "Tomorrow, the numbers are gone."
 },
 {
  "start": 472.45,
  "end": 474.17,
  "text": "But you wake up hearing whispers."
 },
 {
  "start": 475.27,
  "end": 477.27,
  "text": "Everything everyone says about you,"
 },
 {
  "start": 477.27,
  "end": 478.55,
  "text": "when you're not in the room."
 },
 {
  "start": 479.23,
  "end": 480.35,
  "text": "If you want to hear it too,"
 },
 {
  "start": 480.69,
  "end": 481.11,
  "text": "subscribe."
 },
 {
  "start": 481.81,
  "end": 483.93,
  "text": "Because tomorrow, the whispers begin."
 }
]