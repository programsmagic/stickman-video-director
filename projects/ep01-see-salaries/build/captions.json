[
 {
  "start": 0.15,
  "end": 0.95,
  "text": "You wake up,"
 },
 {
  "start": 1.27,
  "end": 1.87,
  "text": "look in the mirror,"
 },
 {
  "start": 2.29,
  "end": 4.33,
  "text": "and there's a number floating above your head."
 },
 {
  "start": 4.33,
  "end": 7.48,
  "text": "Forty-one thousand, two hundred dollars."
 },
 {
  "start": 7.48,
  "end": 9.41,
  "text": "Your exact income this year."
 },
 {
  "start": 10.01,
  "end": 11.45,
  "text": "Every dollar, from every source."
 },
 {
  "start": 12.41,
  "end": 13.17,
  "text": "You look out the window."
 },
 {
  "start": 13.97,
  "end": 15.01,
  "text": "Everyone has one."
 },
 {
  "start": 15.63,
  "end": 16.53,
  "text": "For the next seven days,"
 },
 {
  "start": 16.85,
  "end": 18.87,
  "text": "you can see what every single person earns."
 },
 {
  "start": 19.57,
  "end": 20.59,
  "text": "And by day seven,"
 },
 {
  "start": 20.99,
  "end": 23.15,
  "text": "one of those numbers is going to ruin your life."
 },
 {
  "start": 23.89,
  "end": 25.91,
  "text": "At first, it's just funny."
 },
 {
  "start": 26.51,
  "end": 28.05,
  "text": "The guy in the expensive suit earns"
 },
 {
  "start": 28.05,
  "end": 29.43,
  "text": "barely more than the barista."
 },
 {
  "start": 29.92,
  "end": 31.89,
  "text": "The lady in sweatpants walking her dog?"
 },
 {
  "start": 31.89,
  "end": 33.27,
  "text": "Over a million."
 },
 {
  "start": 34.01,
  "end": 36.25,
  "text": "Lesson one, before you've even had breakfast:"
 },
 {
  "start": 36.79,
  "end": 39.45,
  "text": "you cannot tell what people earn by looking at them."
 },
 {
  "start": 40.29,
  "end": 41.15,
  "text": "It gets stranger."
 },
 {
  "start": 41.91,
  "end": 43.55,
  "text": "The kid on the skateboard makes more"
 },
 {
  "start": 43.55,
  "end": 45.09,
  "text": "than your whole office floor."
 },
 {
  "start": 45.71,
  "end": 47.89,
  "text": "He posts videos about skateboarding."
 },
 {
  "start": 48.33,
  "end": 50.25,
  "text": "The nurse who just worked twelve hours"
 },
 {
  "start": 50.25,
  "end": 52.45,
  "text": "saving lives makes a fifth of that."
 },
 {
  "start": 53.21,
  "end": 55.03,
  "text": "You stand on the corner for a long time,"
 },
 {
  "start": 55.39,
  "end": 56.99,
  "text": "just watching the numbers go by."
 },
 {
  "start": 57.59,
  "end": 58.61,
  "text": "Because for the first time,"
 },
 {
  "start": 59.05,
  "end": 61.39,
  "text": "you're seeing something nobody is supposed to see:"
 },
 {
  "start": 61.87,
  "end": 63.87,
  "text": "what the world actually pays for."
 },
 {
  "start": 64.63,
  "end": 65.91,
  "text": "Then you walk into work."
 },
 {
  "start": 66.93,
  "end": 67.11,
  "text": "Kevin."
 },
 {
  "start": 67.69,
  "end": 70.57,
  "text": "Kevin who forwards your emails and calls it teamwork."
 },
 {
  "start": 71.33,
  "end": 72.877,
  "text": "Kevin makes almost seventeen"
 },
 {
  "start": 72.877,
  "end": 74.97,
  "text": "thousand dollars more than you."
 },
 {
  "start": 75.61,
  "end": 76.87,
  "text": "And here's the uncomfortable part."
 },
 {
  "start": 77.51,
  "end": 78.21,
  "text": "In most offices,"
 },
 {
  "start": 78.43,
  "end": 79.51,
  "text": "nobody talks about pay,"
 },
 {
  "start": 79.87,
  "end": 81.69,
  "text": "so gaps like this can hide for years."
 },
 {
  "start": 82.43,
  "end": 84.21,
  "text": "That's exactly why a growing number of places"
 },
 {
  "start": 84.21,
  "end": 86.53,
  "text": "now require salary ranges in job ads."
 },
 {
  "start": 86.53,
  "end": 88.05,
  "text": "Several U.S. states do it,"
 },
 {
  "start": 88.05,
  "end": 90.43,
  "text": "and the European Union passed a pay transparency"
 },
 {
  "start": 90.43,
  "end": 92.89,
  "text": "law that pushes companies to explain pay gaps."
 },
 {
  "start": 93.33,
  "end": 95.61,
  "text": "The secret salary is slowly dying."
 },
 {
  "start": 96.17,
  "end": 97.05,
  "text": "You're just seeing it early."
 },
 {
  "start": 98.01,
  "end": 99.83,
  "text": "So you do something you've never done before."
 },
 {
  "start": 100.45,
  "end": 101.67,
  "text": "You ask for a raise."
 },
 {
  "start": 102.45,
  "end": 103.05,
  "text": "And this time,"
 },
 {
  "start": 103.45,
  "end": 104.67,
  "text": "you have an unfair advantage."
 },
 {
  "start": 105.25,
  "end": 106.37,
  "text": "You can see the budget."
 },
 {
  "start": 106.97,
  "end": 108.07,
  "text": "You know what the role is worth."
 },
 {
  "start": 108.55,
  "end": 108.95,
  "text": "You don't guess."
 },
 {
  "start": 109.43,
  "end": 110.15,
  "text": "You don't apologize."
 },
 {
  "start": 110.57,
  "end": 111.29,
  "text": "You say a number."
 },
 {
  "start": 111.29,
  "end": 113.83,
  "text": "\"…Fifty-five?\""
 },
 {
  "start": 113.83,
  "end": 115.31,
  "text": "Negotiation researchers have found that"
 },
 {
  "start": 115.31,
  "end": 117.33,
  "text": "many people never ask for more at all,"
 },
 {
  "start": 117.81,
  "end": 118.65,
  "text": "and over a whole career,"
 },
 {
  "start": 119.01,
  "end": 120.51,
  "text": "that silence can cost a fortune."
 },
 {
  "start": 121.29,
  "end": 123.07,
  "text": "You didn't need superpowers to ask."
 },
 {
  "start": 123.63,
  "end": 125.75,
  "text": "You just needed to know you were allowed to."
 },
 {
  "start": 126.71,
  "end": 129.13,
  "text": "After work, your best friend Leo picks you up."
 },
 {
  "start": 129.53,
  "end": 130.63,
  "text": "Leo has the new car."
 },
 {
  "start": 131.07,
  "end": 131.59,
  "text": "The watch."
 },
 {
  "start": 131.77,
  "end": 132.43,
  "text": "The weekend trips."
 },
 {
  "start": 132.67,
  "end": 133.15,
  "text": "The photos."
 },
 {
  "start": 133.47,
  "end": 136.39,
  "text": "And a number barely higher than yours."
 },
 {
  "start": 137.03,
  "end": 138.59,
  "text": "For years you've felt like you"
 },
 {
  "start": 138.59,
  "end": 139.81,
  "text": "were falling behind Leo."
 },
 {
  "start": 140.49,
  "end": 142.85,
  "text": "Now you know Leo is falling too."
 },
 {
  "start": 143.27,
  "end": 144.13,
  "text": "Just more quietly."
 },
 {
  "start": 144.99,
  "end": 146.91,
  "text": "Researchers studying lottery winners in"
 },
 {
  "start": 146.91,
  "end": 148.99,
  "text": "Canada found something wild about this."
 },
 {
  "start": 149.37,
  "end": 151.37,
  "text": "The bigger a neighbour's lottery win,"
 },
 {
  "start": 151.75,
  "end": 153.83,
  "text": "the more the people living next door borrowed,"
 },
 {
  "start": 153.83,
  "end": 155.45,
  "text": "and the more of them went bankrupt."
 },
 {
  "start": 155.85,
  "end": 157.49,
  "text": "Not because they won anything."
 },
 {
  "start": 157.93,
  "end": 159.17,
  "text": "Because they tried to keep up."
 },
 {
  "start": 159.53,
  "end": 160.59,
  "text": "You decide two things."
 },
 {
  "start": 160.99,
  "end": 163.73,
  "text": "You'll stop comparing yourself to Leo's photos."
 },
 {
  "start": 164.23,
  "end": 165.65,
  "text": "And you'll ask him if he's okay."
 },
 {
  "start": 165.65,
  "end": 167.47,
  "text": "That night, you have a date."
 },
 {
  "start": 168.15,
  "end": 170.51,
  "text": "Maya earns more than three times what you do."
 },
 {
  "start": 170.87,
  "end": 171.65,
  "text": "And for a second,"
 },
 {
  "start": 171.67,
  "end": 174.17,
  "text": "something ugly crawls into your chest."
 },
 {
  "start": 174.97,
  "end": 176.59,
  "text": "Psychologists have a name for this."
 },
 {
  "start": 176.97,
  "end": 177.79,
  "text": "Social comparison."
 },
 {
  "start": 178.37,
  "end": 180.43,
  "text": "We don't judge our lives by how much we have."
 },
 {
  "start": 180.43,
  "end": 182.31,
  "text": "We judge them by how much we have"
 },
 {
  "start": 182.31,
  "end": 184.59,
  "text": "compared to the people around us."
 },
 {
  "start": 184.99,
  "end": 185.85,
  "text": "Maya didn't change."
 },
 {
  "start": 186.39,
  "end": 187.65,
  "text": "Her number just appeared."
 },
 {
  "start": 188.37,
  "end": 190.73,
  "text": "You decide not to let a number sit at the table."
 },
 {
  "start": 191.43,
  "end": 192.43,
  "text": "She pays for dessert."
 },
 {
  "start": 192.95,
  "end": 193.53,
  "text": "You let her."
 },
 {
  "start": 194.03,
  "end": 194.95,
  "text": "On the walk to the station,"
 },
 {
  "start": 195.15,
  "end": 196.39,
  "text": "Maya tells you she grew up sharing"
 },
 {
  "start": 196.39,
  "end": 198.03,
  "text": "one bedroom with three sisters."
 },
 {
  "start": 198.51,
  "end": 200.01,
  "text": "That big number above her head?"
 },
 {
  "start": 200.27,
  "end": 202.57,
  "text": "She built it one late night at a time."
 },
 {
  "start": 203.11,
  "end": 204.93,
  "text": "You realize you were jealous of the number."
 },
 {
  "start": 205.45,
  "end": 207.43,
  "text": "You never once thought about the work behind it."
 },
 {
  "start": 207.91,
  "end": 210.23,
  "text": "Walking home, you ask yourself the big question."
 },
 {
  "start": 210.43,
  "end": 212.85,
  "text": "Would you be happier with her number?"
 },
 {
  "start": 212.85,
  "end": 215.43,
  "text": "Scientists have argued about this for years."
 },
 {
  "start": 216.01,
  "end": 217.77,
  "text": "One famous study suggested happiness"
 },
 {
  "start": 217.77,
  "end": 219.85,
  "text": "stops rising above a certain income."
 },
 {
  "start": 220.31,
  "end": 222.19,
  "text": "Newer research found that for most people,"
 },
 {
  "start": 222.19,
  "end": 224.33,
  "text": "happiness keeps rising as income grows,"
 },
 {
  "start": 224.33,
  "end": 225.77,
  "text": "just more slowly."
 },
 {
  "start": 226.43,
  "end": 229.03,
  "text": "Each extra dollar matters less than the one before."
 },
 {
  "start": 229.69,
  "end": 230.41,
  "text": "More money helps."
 },
 {
  "start": 230.75,
  "end": 232.35,
  "text": "But the climb gets steeper,"
 },
 {
  "start": 232.35,
  "end": 234.51,
  "text": "and the view changes less than you'd expect."
 },
 {
  "start": 235.51,
  "end": 236.57,
  "text": "On day five,"
 },
 {
  "start": 236.81,
  "end": 237.63,
  "text": "you visit your parents."
 },
 {
  "start": 238.37,
  "end": 240.49,
  "text": "Your dad's number is lower than yours."
 },
 {
  "start": 240.91,
  "end": 243.97,
  "text": "Lower than yours was before the raise."
 },
 {
  "start": 243.97,
  "end": 244.47,
  "text": "The bike."
 },
 {
  "start": 244.91,
  "end": 245.71,
  "text": "The school trips."
 },
 {
  "start": 246.19,
  "end": 247.67,
  "text": "The laptop for college."
 },
 {
  "start": 248.19,
  "end": 248.75,
  "text": "All of it,"
 },
 {
  "start": 248.75,
  "end": 249.65,
  "text": "from that number."
 },
 {
  "start": 250.57,
  "end": 252.99,
  "text": "You realize a salary tells you what someone earns."
 },
 {
  "start": 252.99,
  "end": 255.41,
  "text": "It tells you nothing about what they've given."
 },
 {
  "start": 256.11,
  "end": 258.79,
  "text": "Later, you ask your dad if he ever wanted more money."
 },
 {
  "start": 258.79,
  "end": 260.25,
  "text": "He laughs."
 },
 {
  "start": 260.25,
  "end": 261.01,
  "text": "\"Of course I did."
 },
 {
  "start": 261.47,
  "end": 263.43,
  "text": "But I wanted to be home for dinner more.\""
 },
 {
  "start": 264.21,
  "end": 265.87,
  "text": "After dinner, you find your mum doing"
 },
 {
  "start": 265.87,
  "end": 267.17,
  "text": "the bills at the kitchen table."
 },
 {
  "start": 267.83,
  "end": 268.97,
  "text": "Every column balanced."
 },
 {
  "start": 269.39,
  "end": 270.27,
  "text": "Every bill paid."
 },
 {
  "start": 270.27,
  "end": 271.81,
  "text": "For thirty years."
 },
 {
  "start": 272.41,
  "end": 273.57,
  "text": "She's never earned much."
 },
 {
  "start": 273.89,
  "end": 276.29,
  "text": "But nobody in this house has ever gone without."
 },
 {
  "start": 276.97,
  "end": 278.11,
  "text": "You sit down next to her,"
 },
 {
  "start": 278.11,
  "end": 279.07,
  "text": "and for once,"
 },
 {
  "start": 279.07,
  "end": 281.29,
  "text": "you ask her to teach you how she does it."
 },
 {
  "start": 282.03,
  "end": 283.63,
  "text": "Then, on day six,"
 },
 {
  "start": 284.11,
  "end": 284.89,
  "text": "something changes."
 },
 {
  "start": 285.47,
  "end": 286.73,
  "text": "It isn't just you anymore."
 },
 {
  "start": 287.35,
  "end": 289.19,
  "text": "Everyone can see everyone's number."
 },
 {
  "start": 289.65,
  "end": 291.61,
  "text": "And the world goes a little crazy."
 },
 {
  "start": 292.43,
  "end": 293.89,
  "text": "Landlords start raising rent"
 },
 {
  "start": 293.89,
  "end": 295.11,
  "text": "for tenants with big numbers."
 },
 {
  "start": 295.81,
  "end": 298.27,
  "text": "Charities only knock on the richest doors."
 },
 {
  "start": 298.27,
  "end": 299.33,
  "text": "And for the first time,"
 },
 {
  "start": 299.45,
  "end": 301.89,
  "text": "every boss has to walk past employees who"
 },
 {
  "start": 301.89,
  "end": 304.13,
  "text": "can see exactly how big the gap is."
 },
 {
  "start": 304.69,
  "end": 305.45,
  "text": "At your office,"
 },
 {
  "start": 305.53,
  "end": 307.47,
  "text": "there's a line outside HR that"
 },
 {
  "start": 307.47,
  "end": 308.45,
  "text": "wraps around the building."
 },
 {
  "start": 308.87,
  "end": 310.15,
  "text": "Even Kevin is in it."
 },
 {
  "start": 310.15,
  "end": 312.69,
  "text": "You finally ask him how he makes more than you."
 },
 {
  "start": 313.11,
  "end": 314.01,
  "text": "He looks embarrassed."
 },
 {
  "start": 314.79,
  "end": 315.85,
  "text": "\"When they offered me the job,"
 },
 {
  "start": 315.85,
  "end": 317.27,
  "text": "I just asked for more."
 },
 {
  "start": 317.51,
  "end": 319.21,
  "text": "They said yes.\""
 },
 {
  "start": 319.21,
  "end": 319.63,
  "text": "That's it."
 },
 {
  "start": 320.01,
  "end": 321.65,
  "text": "One sentence, years ago."
 },
 {
  "start": 322.33,
  "end": 323.43,
  "text": "That's the thing about salaries."
 },
 {
  "start": 323.43,
  "end": 326.79,
  "text": "A small difference at the start follows you for years,"
 },
 {
  "start": 327.17,
  "end": 328.95,
  "text": "because every raise is built on top"
 },
 {
  "start": 328.95,
  "end": 330.35,
  "text": "of the number you began with."
 },
 {
  "start": 331.05,
  "end": 332.07,
  "text": "Here's the wild part."
 },
 {
  "start": 332.35,
  "end": 333.69,
  "text": "This has actually happened."
 },
 {
  "start": 334.25,
  "end": 336.77,
  "text": "In Norway, everyone's income and taxes have"
 },
 {
  "start": 336.77,
  "end": 338.51,
  "text": "been public records for a long time."
 },
 {
  "start": 338.77,
  "end": 339.91,
  "text": "And in 2001,"
 },
 {
  "start": 340.03,
  "end": 341.41,
  "text": "those records went online,"
 },
 {
  "start": 341.57,
  "end": 342.89,
  "text": "searchable by anyone,"
 },
 {
  "start": 342.89,
  "end": 343.85,
  "text": "in seconds."
 },
 {
  "start": 344.57,
  "end": 346.31,
  "text": "Economists studied what happened next."
 },
 {
  "start": 346.95,
  "end": 348.15,
  "text": "When everyone could suddenly look"
 },
 {
  "start": 348.15,
  "end": 349.39,
  "text": "up everyone else's income,"
 },
 {
  "start": 349.89,
  "end": 351.37,
  "text": "the happiness gap between richer"
 },
 {
  "start": 351.37,
  "end": 352.61,
  "text": "and poorer people grew."
 },
 {
  "start": 353.37,
  "end": 354.47,
  "text": "Seeing other people's numbers"
 },
 {
  "start": 354.47,
  "end": 355.65,
  "text": "didn't make people richer."
 },
 {
  "start": 356.21,
  "end": 356.93,
  "text": "For a lot of them,"
 },
 {
  "start": 356.99,
  "end": 358.45,
  "text": "it just made them feel poorer."
 },
 {
  "start": 359.37,
  "end": 362.03,
  "text": "Years later, Norway made searches traceable,"
 },
 {
  "start": 362.17,
  "end": 364.15,
  "text": "so people could see who had looked them up."
 },
 {
  "start": 364.65,
  "end": 366.37,
  "text": "Searches fell from around sixteen"
 },
 {
  "start": 366.37,
  "end": 368.49,
  "text": "million a year to about two million."
 },
 {
  "start": 369.51,
  "end": 371.17,
  "text": "Remember the number from the first morning?"
 },
 {
  "start": 371.17,
  "end": 373.33,
  "text": "The one that was going to ruin your life?"
 },
 {
  "start": 373.33,
  "end": 374.79,
  "text": "On day seven,"
 },
 {
  "start": 374.79,
  "end": 376.17,
  "text": "you finally see it."
 },
 {
  "start": 376.47,
  "end": 378.67,
  "text": "It's above the quiet janitor in your building."
 },
 {
  "start": 378.87,
  "end": 380.71,
  "text": "The one who's worked there for thirty years."
 },
 {
  "start": 380.71,
  "end": 383.07,
  "text": "Nine point eight million."
 },
 {
  "start": 383.73,
  "end": 386.09,
  "text": "He bought the building's shares in the eighties."
 },
 {
  "start": 386.09,
  "end": 386.85,
  "text": "Saved every month."
 },
 {
  "start": 387.21,
  "end": 387.95,
  "text": "Never told anyone."
 },
 {
  "start": 388.63,
  "end": 390.81,
  "text": "Today, the dividends alone pay him more"
 },
 {
  "start": 390.81,
  "end": 392.47,
  "text": "than everyone in the office combined."
 },
 {
  "start": 393.19,
  "end": 394.01,
  "text": "He waves at you."
 },
 {
  "start": 394.13,
  "end": 394.87,
  "text": "Same as always."
 },
 {
  "start": 395.51,
  "end": 397.43,
  "text": "At lunch, you sit next to him on the loading dock."
 },
 {
  "start": 397.43,
  "end": 399.43,
  "text": "You ask the only question that matters."
 },
 {
  "start": 400.13,
  "end": 401.29,
  "text": "Why are you still here?"
 },
 {
  "start": 401.95,
  "end": 402.29,
  "text": "He shrugs."
 },
 {
  "start": 403.11,
  "end": 403.65,
  "text": "\"I like the work."
 },
 {
  "start": 403.97,
  "end": 404.67,
  "text": "I like the people."
 },
 {
  "start": 404.83,
  "end": 406.97,
  "text": "And I never needed anyone to know my number.\""
 },
 {
  "start": 407.73,
  "end": 409.93,
  "text": "You ask him if he ever felt like giving up on saving."
 },
 {
  "start": 410.89,
  "end": 412.47,
  "text": "\"Every month for thirty years,"
 },
 {
  "start": 412.57,
  "end": 413.59,
  "text": "I put a little away."
 },
 {
  "start": 414.05,
  "end": 415.27,
  "text": "Most months, it felt like nothing."
 },
 {
  "start": 415.69,
  "end": 416.25,
  "text": "Then one day,"
 },
 {
  "start": 416.25,
  "end": 417.03,
  "text": "I looked up,"
 },
 {
  "start": 417.03,
  "end": 417.77,
  "text": "and it was everything.\""
 },
 {
  "start": 418.47,
  "end": 419.99,
  "text": "Then he gives you the only financial"
 },
 {
  "start": 419.99,
  "end": 421.37,
  "text": "advice he's ever given anyone."
 },
 {
  "start": 422.03,
  "end": 423.15,
  "text": "\"Spend less than you make."
 },
 {
  "start": 423.15,
  "end": 424.89,
  "text": "Own things that pay you."
 },
 {
  "start": 424.89,
  "end": 426.93,
  "text": "And stop looking at other people's numbers.\""
 },
 {
  "start": 427.43,
  "end": 428.77,
  "text": "It didn't ruin your life."
 },
 {
  "start": 429.15,
  "end": 431.27,
  "text": "It ruined the way you used to judge people."
 },
 {
  "start": 431.27,
  "end": 433.31,
  "text": "At midnight, the numbers fade."
 },
 {
  "start": 433.79,
  "end": 435.25,
  "text": "The last one to go is your own."
 },
 {
  "start": 435.69,
  "end": 436.17,
  "text": "A week ago,"
 },
 {
  "start": 436.29,
  "end": 437.41,
  "text": "that number felt like a grade."
 },
 {
  "start": 437.73,
  "end": 439.69,
  "text": "Like a score of how much you were worth."
 },
 {
  "start": 440.19,
  "end": 441.55,
  "text": "Now it just looks like what it is."
 },
 {
  "start": 441.99,
  "end": 444.95,
  "text": "A price someone agreed to pay for your time this year."
 },
 {
  "start": 445.35,
  "end": 446.91,
  "text": "It says nothing about your dad's cooking,"
 },
 {
  "start": 447.25,
  "end": 448.03,
  "text": "your mum's notebook,"
 },
 {
  "start": 448.17,
  "end": 450.17,
  "text": "or the janitor who waves every morning."
 },
 {
  "start": 450.75,
  "end": 452.35,
  "text": "Here's what seven days of seeing"
 },
 {
  "start": 452.35,
  "end": 453.93,
  "text": "everyone's salary taught you."
 },
 {
  "start": 454.21,
  "end": 455.79,
  "text": "You can't read wealth from clothes."
 },
 {
  "start": 455.79,
  "end": 458.83,
  "text": "Not knowing what others earn can cost you real money,"
 },
 {
  "start": 458.91,
  "end": 459.65,
  "text": "so ask."
 },
 {
  "start": 460.29,
  "end": 461.85,
  "text": "Comparing numbers can steal your"
 },
 {
  "start": 461.85,
  "end": 463.55,
  "text": "happiness faster than any bill."
 },
 {
  "start": 464.17,
  "end": 465.83,
  "text": "And the number above someone's head is"
 },
 {
  "start": 465.83,
  "end": 467.51,
  "text": "the least interesting thing about them."
 },
 {
  "start": 467.99,
  "end": 470.07,
  "text": "Tomorrow, you wake up and see a different number."
 },
 {
  "start": 470.53,
  "end": 470.93,
  "text": "Not money."
 },
 {
  "start": 471.65,
  "end": 471.91,
  "text": "Karma."
 },
 {
  "start": 472.91,
  "end": 475.15,
  "text": "If you want to see what happens next,"
 },
 {
  "start": 475.43,
  "end": 475.95,
  "text": "subscribe."
 },
 {
  "start": 476.85,
  "end": 477.85,
  "text": "Because tomorrow at midnight,"
 },
 {
  "start": 477.85,
  "end": 479.33,
  "text": "the numbers change again."
 }
]